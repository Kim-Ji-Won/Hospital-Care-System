# 이 파일을 .env.local로 복사해 고칩니다.

# Spring Boot 백엔드 주소. 브라우저의 /api 요청을 여기로 넘깁니다.
BACKEND_URL=http://localhost:8080

# 목 서버 범위: all(기본) | none | 영역 목록(예: member,reservation)
# 목록에 없는 영역은 실제 백엔드로 갑니다. 영역 이름은 docs/api 파일 이름과 같습니다.
NEXT_PUBLIC_API_MOCKING=all

# 시연 패널(오른쪽 아래)을 숨기려면 off
NEXT_PUBLIC_DEMO_PANEL=on
